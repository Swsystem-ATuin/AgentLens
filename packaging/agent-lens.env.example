# Shared by the systemd and SysV/cron examples. Keep values free of shell
# expansions: systemd EnvironmentFile and POSIX shell assignment syntax overlap
# for these simple values.
AGENT_LENS_DB=/var/lib/agent-lens/agent-lens.sqlite
AGENT_LENS_STATE_DB=/var/lib/agent-lens/agent-lens-state.sqlite
# Default keyring is beside the state database; never put key material in this file.
# AGENT_LENS_MFA_KEY_FILE=/var/lib/agent-lens/agent-lens-state.mfa-keys.json
AGENT_LENS_DATA=/var/lib/agent-lens/data
AGENT_LENS_BIND=127.0.0.1:3001
AGENT_LENS_LOCAL=false
AGENT_LENS_SECURE_COOKIES=false
# Opt-in passkey second factors stay disabled until an exact HTTPS origin is configured.
# Requires AGENT_LENS_SECURE_COOKIES=true; RP ID is derived from this hostname.
# AGENT_LENS_PUBLIC_URL=https://lens.example.org
# AGENT_LENS_PROJECTS_FILE=/etc/agent-lens/projects.json
# RUST_LOG=agent_lens=info
