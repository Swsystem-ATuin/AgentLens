[Unit]
Description=Refresh the Agent Lens disposable index
Documentation=https://github.com/Swsystem-ATuin/AgentLens
After=local-fs.target

[Service]
Type=oneshot
User=agent-lens
Group=agent-lens
EnvironmentFile=/etc/agent-lens/agent-lens.env
WorkingDirectory=/var/lib/agent-lens
ExecStart=/usr/local/bin/agent-lens refresh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-lens
